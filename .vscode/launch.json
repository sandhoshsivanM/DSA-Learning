{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run problem",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/DSA.dll",
      "args": ["${input:problemNumber}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "problemNumber",
      "type": "promptString",
      "description": "LeetCode problem number to run (or 'list')",
      "default": "217"
    }
  ]
}
